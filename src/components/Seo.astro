---
export interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "profile" | "article";
}

const {
  title,
  description,
  path,
  image = "/media/og-image.png",
  imageAlt = "Robin Kali - Developer & Creator",
  ogType = "website",
} = Astro.props;

if (!Astro.site) throw new Error("Astro.site is required to generate SEO metadata");
const siteUrl = Astro.site.toString().replace(/\/$/, "");
const withTrailingSlash = (value: string) =>
  value.endsWith("/") ? value : `${value}/`;
const canonical = new URL(withTrailingSlash(path), `${siteUrl}/`).toString();
const imageUrl = new URL(image, `${siteUrl}/`).toString();
const isPng = imageUrl.endsWith(".png");
const pageId = `${canonical}#webpage`;
const personId = `${siteUrl}/#person`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: "Robin Kali",
      url: `${siteUrl}/`,
      description: "Personal website & biography of Robin Kali — Developer & Creator.",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Robin Kali",
      jobTitle: "Developer & Creator",
      url: `${siteUrl}/`,
      sameAs: [
        "https://github.com/RobinKali",
        "https://www.linkedin.com/in/robin-kalaykhan-4b2443153/",
        "https://kaliwebworks.nl",
      ],
    },
    {
      "@type": "WebPage",
      "@id": pageId,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": personId },
    },
  ],
};
---
<title>{title} — Robin Kali</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#030712" />
<meta name="author" content="Robin Kali" />

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Robin Kali" />
<meta property="og:title" content={`${title} — Robin Kali`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{isPng && <meta property="og:image:width" content="1200" />}
{isPng && <meta property="og:image:height" content="630" />}
{isPng && <meta property="og:image:type" content="image/png" />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} — Robin Kali`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

<link rel="canonical" href={canonical} />
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
