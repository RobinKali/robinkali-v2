---
const copy = {
  title: "Your Privacy",
  description: "This site uses essential cookies and local storage to preserve your preferences and deliver interactive 3D experiences.",
  accept: "Accept",
  reject: "Decline",
  cookies: "Cookie Policy",
  privacy: "Privacy Policy",
};
const cookiePath = "/legal/cookies/";
const privacyPath = "/legal/privacy/";
---
<aside class="cookie-consent" data-cookie-consent aria-label={copy.title} hidden>
  <div class="cookie-consent__content">
    <p class="cookie-consent__title">{copy.title}</p>
    <p class="cookie-consent__description">{copy.description}</p>
    <p><a href={cookiePath}>{copy.cookies}</a> · <a href={privacyPath}>{copy.privacy}</a></p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" data-cookie-consent-accept>{copy.accept}</button>
    <button type="button" data-cookie-consent-reject>{copy.reject}</button>
  </div>
</aside>
<script is:inline>
  (() => {
    const banner = document.querySelector("[data-cookie-consent]");
    if (!banner) return;
    const hide = () => { banner.hidden = true; };
    const key = "robinkali-consent";
    if (localStorage.getItem(key)) hide();
    else banner.hidden = false;
    banner.querySelector("[data-cookie-consent-accept]")?.addEventListener("click", () => {
      localStorage.setItem(key, "accepted");
      hide();
    });
    banner.querySelector("[data-cookie-consent-reject]")?.addEventListener("click", () => {
      localStorage.setItem(key, "rejected");
      hide();
    });
    document.addEventListener("click", (event) => {
      if (event.target.closest("[data-cookie-consent-reset]")) {
        localStorage.removeItem(key);
        banner.hidden = false;
      }
    });
  })();
</script>
