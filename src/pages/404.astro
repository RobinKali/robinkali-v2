---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404: Coordinate Lost";
const pageDescription = "The page you are looking for has drifted into deep space or does not exist.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/404/"
>
  <div class="not-found-container">
    <!-- Ambient glowing backdrop -->
    <div class="not-found-glow" aria-hidden="true"></div>

    <div class="not-found-card">
      <div class="not-found-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>ERROR 404 &#8226; DEEP SPACE DRIFT</span>
      </div>

      <h1 class="not-found-title">404</h1>
      <h2 class="not-found-subtitle">Lost in the Void</h2>
      <p class="not-found-desc">
        The coordinates you entered do not match any known stellar waypoint or document in this system.
      </p>

      <div class="not-found-actions">
        <a href="/" class="not-found-btn not-found-btn--primary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Return Home</span>
        </a>
        <a href="/about/" class="not-found-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <span>About Robin</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    position: relative;
    background: radial-gradient(circle at 50% 40%, #070e24 0%, #02040a 100%);
    overflow: hidden;
  }

  .not-found-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.12) 0%, rgba(168, 85, 247, 0.12) 40%, transparent 70%);
    pointer-events: none;
    filter: blur(40px);
  }

  .not-found-card {
    position: relative;
    z-index: 2;
    max-width: 540px;
    width: 100%;
    padding: 3.5rem 2.5rem;
    text-align: center;
    background: rgba(10, 15, 30, 0.7);
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: 28px;
    box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.7), 0 0 40px rgba(168, 85, 247, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .not-found-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00f2fe;
    box-shadow: 0 0 8px #00f2fe;
  }

  .not-found-title {
    font-size: clamp(5rem, 14vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    margin: 0 0 0.5rem;
    letter-spacing: 0.05em;
    background: linear-gradient(135deg, #ffffff 0%, #38bdf8 50%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 24px rgba(0, 242, 254, 0.3));
  }

  .not-found-subtitle {
    font-size: 1.35rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  .not-found-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 2.25rem;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .not-found-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
    color: #ffffff;
  }

  .not-found-btn--primary {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.2) 0%, rgba(168, 85, 247, 0.25) 100%);
    border-color: rgba(0, 242, 254, 0.4);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.2);
  }

  .not-found-btn--primary:hover {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.35) 0%, rgba(168, 85, 247, 0.4) 100%);
    border-color: rgba(0, 242, 254, 0.6);
    box-shadow: 0 6px 28px rgba(0, 242, 254, 0.35);
  }
</style>
