---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legalDocuments, type LegalDocument } from "../../data/legal";

export function getStaticPaths() {
  return legalDocuments.map((page) => ({
    params: { document: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: LegalDocument };
const isCookiePolicy = page.slug === "cookies";
---
<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="legal-page" aria-labelledby="legal-page-title">
    <header class="legal-page__header">
      <nav class="legal-page__breadcrumb" aria-label="Legal document navigation">
        <a href="/">
          <span aria-hidden="true">←</span>
          Back to Home
        </a>
        <span class="legal-page__breadcrumb-separator" aria-hidden="true">/</span>
        <span aria-current="page">{page.title}</span>
      </nav>

      <p class="legal-page__status">{page.status}</p>
      <h1 id="legal-page-title" class="legal-page__title">{page.title}</h1>
      <p class="legal-page__lead">{page.description}</p>
      <p class="legal-page__identity">ROBIN KALI</p>
    </header>

    <div class="legal-page__body">
      {page.sections.map((section) => (
        <section class="legal-page__section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.items && (
            <ul>
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))}

      {isCookiePolicy && (
        <section class="legal-page__section legal-page__actions">
          <h2>Cookie Settings</h2>
          <p>You can reset your cookie consent choice at any time.</p>
          <button type="button" class="button" data-cookie-consent-reset>
            Reset Cookie Consent
          </button>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
