---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const pageTitle = "Home";
const pageDescription = `${profile.name} — ${profile.role}. ${profile.tagline}`;
const particleTitle = "ROBIN KALI";
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  image={profile.avatar}
  imageAlt={profile.avatarAlt}
  immersive
>
  <section class="wormhole-home" aria-label={`${profile.name} — Interactive Entry`}>
    <iframe
      class="wormhole-home__frame"
      data-wormhole-frame
      src="/wormhole-home.html"
      title="Interactive 3D space scene"
    ></iframe>

    <!-- Floating circular button leading to About Me with hyper-travel transition -->
    <a
      class="wormhole-home__space-btn"
      data-hyper-travel
      href="/about/"
      aria-label={`Enter space: About ${profile.name}`}
      title="Click to launch Hyper Travel"
    >
      <div class="space-btn__pulse" aria-hidden="true"></div>
      <div class="space-btn__ring" aria-hidden="true"></div>
      <div class="space-btn__content">
        <svg class="space-btn__icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
        </svg>
        <span class="space-btn__text">Go to Space</span>
      </div>
    </a>

    <!-- Interactive 3D Canvas Particle Title -->
    <div class="title-particles" aria-hidden="true">
      <canvas data-title-particles data-title={particleTitle}></canvas>
    </div>
    <h1
      class="title-particles__fallback"
      data-title-fallback
      data-title={particleTitle}>{particleTitle}</h1>

    <!-- Sleek Floating Bottom Dock / Footer Callout -->
    <footer class="wormhole-dock" aria-label="Quick links and KaliWebWorks callout">
      <div class="wormhole-dock__inner">
        <div class="wormhole-dock__callout">
          <span>{profile.callout.text}</span>
          <a
            href={profile.callout.url}
            target="_blank"
            rel="noopener noreferrer"
            class="wormhole-dock__highlight"
          >
            {profile.callout.linkText}
          </a>
        </div>

        <nav class="wormhole-dock__nav" aria-label="Social and navigation links">
          <a
            href="/about/"
            class="wormhole-dock__btn wormhole-dock__btn--primary"
            data-wormhole-link
          >
            About Me
          </a>
          <a
            href={profile.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="wormhole-dock__btn"
            aria-label="GitHub Profile"
          >
            <svg class="dock-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href={profile.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="wormhole-dock__btn"
            aria-label="LinkedIn Profile"
          >
            <svg class="dock-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a
            href={profile.socials.email}
            class="wormhole-dock__btn"
            aria-label="Send an Email"
          >
            <svg class="dock-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l9.522 7.717 9.478-7.682v11.782h-19z"/>
            </svg>
            <span>Email</span>
          </a>
        </nav>
      </div>
    </footer>
  </section>
</BaseLayout>

<script src="../scripts/title-particles.ts"></script>

<style>
  .wormhole-home {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #010208;
  }

  .wormhole-home__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 1;
    background: transparent;
  }

  /* Floating circular button */
  .wormhole-home__space-btn {
    position: absolute;
    z-index: 4;
    top: 66%;
    left: 50%;
    width: clamp(100px, 12vw, 130px);
    height: clamp(100px, 12vw, 130px);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(1);
    transform-origin: center;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 280ms ease;
    user-select: none;
    -webkit-user-select: none;
  }

  .space-btn__ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      #d9a13d,
      #f5d77f,
      #3b82f6,
      #93c5fd,
      #d9a13d
    );
    opacity: 0.85;
    animation: rotateRing 6s linear infinite;
    filter: drop-shadow(0 0 12px rgba(217, 161, 61, 0.6));
  }

  .space-btn__pulse {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(245, 215, 127, 0.4);
    animation: spacePulse 2.8s cubic-bezier(0.2, 0.8, 0.4, 1) infinite;
    pointer-events: none;
  }

  .space-btn__content {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #151d32 0%, #060913 75%, #020408 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.5rem;
    box-shadow:
      inset 0 1px 2px rgba(255, 255, 255, 0.2),
      inset 0 -2px 6px rgba(0, 0, 0, 0.7),
      0 10px 28px rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .space-btn__icon {
    color: #f5d77f;
    filter: drop-shadow(0 2px 6px rgba(217, 161, 61, 0.5));
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), color 240ms ease;
  }

  .space-btn__text {
    font-family: Arial, sans-serif;
    font-size: clamp(0.68rem, 1vw, 0.76rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f4e6ca;
    text-align: center;
    line-height: 1.1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    transition: color 240ms ease, letter-spacing 240ms ease;
  }

  .wormhole-home__space-btn:hover,
  .wormhole-home__space-btn:focus-visible {
    transform: translate(-50%, -50%) scale(1.18);
  }

  .wormhole-home__space-btn:hover .space-btn__ring,
  .wormhole-home__space-btn:focus-visible .space-btn__ring {
    opacity: 1;
    filter: drop-shadow(0 0 20px rgba(245, 215, 127, 0.85));
    animation-duration: 3s;
  }

  .wormhole-home__space-btn:hover .space-btn__icon,
  .wormhole-home__space-btn:focus-visible .space-btn__icon {
    transform: translateY(-2px) rotate(-6deg);
    color: #ffffff;
  }

  .wormhole-home__space-btn:hover .space-btn__text,
  .wormhole-home__space-btn:focus-visible .space-btn__text {
    color: #ffffff;
    letter-spacing: 0.18em;
  }

  .wormhole-home__space-btn.is-transitioning {
    transform: translate(-50%, -50%) scale(1.45);
    pointer-events: none;
  }

  .wormhole-home__space-btn.is-transitioning .space-btn__ring {
    animation-duration: 0.8s;
    filter: drop-shadow(0 0 32px rgba(245, 215, 127, 1));
  }

  .wormhole-home__space-btn:focus-visible {
    outline: 2px solid #f4e6ca;
    outline-offset: 6px;
  }

  @keyframes rotateRing {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes spacePulse {
    0% {
      transform: scale(0.95);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.22);
      opacity: 0;
    }
    100% {
      transform: scale(1.22);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .wormhole-home__space-btn {
      top: 65%;
      width: 96px;
      height: 96px;
    }
    .space-btn__icon {
      width: 19px;
      height: 19px;
    }
    .space-btn__text {
      font-size: 0.65rem;
    }
  }

  /* Bottom Dock / Bar */
  .wormhole-dock {
    position: absolute;
    z-index: 10;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(94%, 960px);
    pointer-events: auto;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .wormhole-dock.is-transitioning {
    opacity: 0;
    transform: translate(-50%, 20px);
    pointer-events: none;
  }

  .wormhole-dock__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    background: rgba(3, 5, 11, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(217, 161, 61, 0.35);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.75),
      0 0 16px rgba(217, 161, 61, 0.15);
  }

  .wormhole-dock__callout {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    color: rgba(244, 230, 202, 0.85);
  }

  .wormhole-dock__highlight {
    color: #f5d77f;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }

  .wormhole-dock__highlight:hover {
    color: #ffffff;
  }

  .wormhole-dock__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .wormhole-dock__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #f4e6ca;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(244, 230, 202, 0.16);
    text-decoration: none;
    transition: all 180ms ease;
  }

  .wormhole-dock__btn:hover {
    background: rgba(217, 161, 61, 0.22);
    border-color: rgba(217, 161, 61, 0.6);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .wormhole-dock__btn--primary {
    background: rgba(217, 161, 61, 0.25);
    border-color: #d9a13d;
    color: #f5d77f;
  }

  .wormhole-dock__btn--primary:hover {
    background: #d9a13d;
    color: #03050b;
  }

  .dock-icon {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .wormhole-dock {
      bottom: 0.75rem;
      width: 96%;
    }
    .wormhole-dock__inner {
      border-radius: 16px;
      justify-content: center;
      text-align: center;
      padding: 0.65rem 0.85rem;
    }
    .wormhole-dock__callout {
      width: 100%;
      justify-content: center;
      font-size: 0.78rem;
    }
    .wormhole-dock__nav {
      justify-content: center;
      width: 100%;
    }
  }
</style>
